# Development Dockerfile for React Frontend with hot reload
FROM node:20-alpine

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm install

# Copy source code
COPY . .

# Expose port
EXPOSE 5173

# Install deps at startup in case the node_modules anonymous volume is empty
# (happens when containers are recreated after `make down`), then start dev server.
CMD ["sh", "-c", "npm install && npm run dev"]
